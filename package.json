{
  "name": "bazaar",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Bazaar — proof-of-quality payments for AI services on Arc: autonomous agents pay sub-cent USDC per call for real AI work; under-delivery is slashed on-chain and the buyer refunded.",
  "scripts": {
    "demo": "tsx src/runner/demo.ts",
    "slice1": "tsx src/runner/slice1.ts",
    "economy": "tsx src/runner/economy.ts",
    "slash": "tsx src/runner/slash.ts",
    "trustless": "tsx src/runner/trustless-slash.ts",
    "circle:pay": "tsx src/runner/circle-pay.ts",
    "byoa:ext": "tsx src/runner/byoa-external.ts",
    "beginner": "tsx src/runner/beginner-agent.ts",
    "circle:trustless": "tsx src/runner/circle-trustless.ts",
    "circle:setup": "node circle-setup.mjs",
    "verify": "tsx src/runner/verify.ts",
    "market": "tsx src/runner/market.ts",
    "market:public": "tsx src/runner/market-public.ts",
    "settle:remote": "tsx src/runner/remote-settler.ts",
    "register": "tsx src/runner/register.ts",
    "byoa": "tsx src/runner/byoa.ts",
    "seller": "tsx src/runner/seller-proc.ts",
    "settle": "tsx src/runner/settler.ts",
    "check": "tsc --noEmit",
    "test": "tsx --test src/evidence/artifacts.test.ts",
    "ci": "npm run check && npm test"
  },
  "dependencies": {
    "express": "5.2.1",
    "viem": "2.55.8"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "25.7.0",
    "tsx": "4.23.1",
    "typescript": "5.9.3"
  },
  "keywords": [
    "arc",
    "circle",
    "lepton",
    "nanopayments",
    "ai-agents",
    "x402",
    "usdc"
  ],
  "license": "MIT"
}
